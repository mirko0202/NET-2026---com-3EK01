@implements IDisposable
@inject IAuthService AuthService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Gestión de Stock</a>
        <button title="Menú de navegación" class="navbar-toggler" @onclick="AlternarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@ClaseMenu nav-scrollable" @onclick="AlternarMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="productos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Productos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ingredientes">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ingredientes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ventas">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Ventas
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ingresos">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Ingresos de mercadería
            </NavLink>
        </div>

        @if (esAdministrador)
        {
            <div class="nav-seccion px-3">Administración</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="sucursales">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sucursales
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuarios">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Usuarios
                </NavLink>
            </div>

            <div class="nav-seccion px-3">Reportes</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reportes/ventas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ventas por período
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reportes/bajo-stock">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Stock bajo el mínimo
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool menuColapsado = true;
    private bool esAdministrador;

    private string? ClaseMenu => menuColapsado ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationStateChanged += OnCambioDeSesion;
        esAdministrador = await AuthService.EsAdministradorAsync();
    }

    private void OnCambioDeSesion(bool autenticado)
    {
        _ = InvokeAsync(async () =>
        {
            esAdministrador = autenticado && await AuthService.EsAdministradorAsync();
            StateHasChanged();
        });
    }

    private void AlternarMenu()
    {
        menuColapsado = !menuColapsado;
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnCambioDeSesion;
    }
}
