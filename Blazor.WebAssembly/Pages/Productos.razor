@page "/productos"
@inherits PaginaAutenticada
@inject IJSRuntime JS

<PageTitle>Productos - Gestión de Stock</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">
        Productos
        @if (!EsAdministrador)
        {
            <small class="text-muted fs-6">(solo consulta)</small>
        }
    </h3>
    @if (EsAdministrador)
    {
        <button class="btn btn-primary" @onclick="() => modal.MostrarAlta()">Agregar producto</button>
    }
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h6 class="card-subtitle mb-2 text-muted">Búsqueda con filtros</h6>
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input class="form-control" placeholder="Nombre o descripción..." maxlength="100"
                       @bind="texto" @bind:event="oninput" @onkeydown="TeclaEnBusquedaAsync" />
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="soloBajoStock"
                           @bind="soloBajoStock" @bind:after="BuscarAsync" />
                    <label class="form-check-label" for="soloBajoStock">Solo productos bajo stock mínimo</label>
                </div>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary" @onclick="BuscarAsync">Buscar</button>
                <button class="btn btn-outline-secondary" @onclick="LimpiarAsync">Limpiar</button>
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center my-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Unidad</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Stock mín.</th>
                    <th>Estado</th>
                    @if (EsAdministrador)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in productos)
                {
                    <tr class="@(producto.BajoStock ? "table-danger" : null)">
                        <td>@producto.Id</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.Descripcion</td>
                        <td>@producto.Unidad</td>
                        <td class="text-end">@producto.Stock</td>
                        <td class="text-end">@producto.StockMin</td>
                        <td>
                            @if (producto.BajoStock)
                            {
                                <span class="badge bg-danger">Bajo stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">OK</span>
                            }
                        </td>
                        @if (EsAdministrador)
                        {
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarAsync(producto)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAsync(producto)">Eliminar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted">
        @(productos.Count == 1 ? "1 producto encontrado" : $"{productos.Count} productos encontrados")
    </p>
}

<ProductoModal @ref="modal" OnGuardado="AlGuardarAsync" />

@code {
    private List<ProductoDTO> productos = new();
    private ProductoModal modal = default!;
    private string texto = string.Empty;
    private bool soloBajoStock;
    private bool cargando = true;
    private string? mensajeExito;
    private string? mensajeError;

    protected override async Task OnAutenticadoAsync()
    {
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        try
        {
            cargando = true;

            var resultado = string.IsNullOrWhiteSpace(texto) && !soloBajoStock
                ? await ProductoApiClient.GetAllAsync()
                : await ProductoApiClient.GetByCriteriaAsync(texto.Trim(), soloBajoStock);

            productos = resultado.ToList();
        }
        catch (Exception ex)
        {
            mensajeError = MensajeDeError(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task TeclaEnBusquedaAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await BuscarAsync();
    }

    private async Task LimpiarAsync()
    {
        texto = string.Empty;
        soloBajoStock = false;
        await BuscarAsync();
    }

    private async Task EditarAsync(ProductoDTO seleccionado)
    {
        try
        {
            mensajeError = null;
            mensajeExito = null;
            var producto = await ProductoApiClient.GetAsync(seleccionado.Id);
            modal.MostrarEdicion(producto);
        }
        catch (Exception ex)
        {
            mensajeError = MensajeDeError(ex);
        }
    }

    private async Task EliminarAsync(ProductoDTO producto)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el producto \"{producto.Nombre}\"?");

        if (!confirmar)
            return;

        try
        {
            mensajeError = null;
            mensajeExito = null;
            await ProductoApiClient.DeleteAsync(producto.Id);
            mensajeExito = $"Producto \"{producto.Nombre}\" eliminado.";
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensajeError = MensajeDeError(ex);
        }
    }

    private async Task AlGuardarAsync(string mensaje)
    {
        mensajeError = null;
        mensajeExito = mensaje;
        await BuscarAsync();
    }
}
