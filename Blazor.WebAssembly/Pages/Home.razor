@page "/"
@inherits PaginaAutenticada

<PageTitle>Inicio - Gestión de Stock</PageTitle>

@if (Usuario != null)
{
    <h1 class="mb-1">Bienvenido, @Usuario.NombreCompleto</h1>
    <p class="lead text-muted">Sistema de gestión de stock para tienda gastronómica</p>

    <div class="alert alert-light border">
        @if (EsAdministrador)
        {
            <text><strong>Perfil Administrador:</strong> gestiona productos, ingredientes, ventas, ingresos de mercadería,
            sucursales y usuarios, y consulta los reportes.</text>
        }
        else
        {
            <text><strong>Perfil Empleado:</strong> consulta el stock y el historial de ingresos, y registra ventas.</text>
        }
        @if (!string.IsNullOrEmpty(Usuario.SucursalNombre))
        {
            <span class="text-muted"> Sucursal: @Usuario.SucursalNombre.</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="row g-3">
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Productos</h5>
                    <p class="card-text text-muted">
                        @(productosBajoStock == null ? "Cargando..." : $"{productosBajoStock} de {productosTotales} por debajo del stock mínimo.")
                    </p>
                    <a class="btn btn-primary" href="productos">Ver productos</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Ingredientes</h5>
                    <p class="card-text text-muted">
                        @(ingredientesBajoStock == null ? "Cargando..." : $"{ingredientesBajoStock} de {ingredientesTotales} por debajo del stock mínimo.")
                    </p>
                    <a class="btn btn-primary" href="ingredientes">Ver ingredientes</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Ventas</h5>
                    <p class="card-text text-muted">
                        @(ventasDelMes == null ? "Cargando..." : $"{ventasDelMes} ventas este mes por {totalDelMes:C0}.")
                    </p>
                    <a class="btn btn-primary" href="ventas">Ver ventas</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@(EsAdministrador ? "Reportes" : "Ingresos de mercadería")</h5>
                    <p class="card-text text-muted">
                        @(EsAdministrador
                            ? "Ventas por período y sucursal con gráfico, y stock bajo el mínimo, con exportación a PDF."
                            : "Historial de reposiciones de mercadería por producto y período.")
                    </p>
                    <a class="btn btn-primary" href="@(EsAdministrador ? "reportes/ventas" : "ingresos")">
                        @(EsAdministrador ? "Ver reportes" : "Ver ingresos")
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int? productosTotales;
    private int? productosBajoStock;
    private int? ingredientesTotales;
    private int? ingredientesBajoStock;
    private int? ventasDelMes;
    private decimal totalDelMes;
    private string? error;

    protected override async Task OnAutenticadoAsync()
    {
        try
        {
            var productos = (await ProductoApiClient.GetAllAsync()).ToList();
            productosTotales = productos.Count;
            productosBajoStock = productos.Count(p => p.BajoStock);

            var ingredientes = (await IngredienteApiClient.GetAllAsync()).ToList();
            ingredientesTotales = ingredientes.Count;
            ingredientesBajoStock = ingredientes.Count(i => i.BajoStock);

            var inicioDelMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var ventas = (await VentaApiClient.GetAllAsync()).Where(v => v.FechaHora >= inicioDelMes).ToList();
            ventasDelMes = ventas.Count;
            totalDelMes = ventas.Sum(v => v.Total);
        }
        catch (Exception ex)
        {
            error = MensajeDeError(ex);
        }
    }
}
