@inject NavigationManager Navigation

@if (visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="producto" OnSubmit="GuardarAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">@(modo == FormMode.Add ? "Nuevo producto" : "Modificar producto")</h5>
                        <button type="button" class="btn-close" @onclick="Cerrar" disabled="@guardando"></button>
                    </div>

                    <div class="modal-body">
                        @if (modo == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input class="form-control" value="@producto.Id" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="nombre">Nombre *</label>
                            <InputText id="nombre" class="@ClaseCampo("Nombre")" @bind-Value="producto.Nombre" maxlength="100" />
                            <div class="invalid-feedback">@Error("Nombre")</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="categoria">Categoría *</label>
                            <InputSelect id="categoria" class="@ClaseSelect("Categoria")" @bind-Value="producto.Categoria">
                                <option value="0">Seleccione una categoría...</option>
                                @foreach (var categoria in Categorias)
                                {
                                    <option value="@categoria.Id">@categoria.Nombre</option>
                                }
                            </InputSelect>
                            <div class="invalid-feedback">@Error("Categoria")</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="descripcion">Descripción</label>
                            <InputTextArea id="descripcion" class="@ClaseCampo("Descripcion")" rows="2"
                                           @bind-Value="producto.Descripcion" maxlength="255" />
                            <div class="invalid-feedback">@Error("Descripcion")</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="unidad">Unidad</label>
                            <InputText id="unidad" class="@ClaseCampo("Unidad")" @bind-Value="producto.Unidad"
                                       list="unidades-producto" maxlength="20" />
                            <datalist id="unidades-producto">
                                <option value="unidad"></option>
                                <option value="kg"></option>
                                <option value="litro"></option>
                                <option value="docena"></option>
                                <option value="porción"></option>
                            </datalist>
                            <div class="invalid-feedback">@Error("Unidad")</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="precio">Precio de venta *</label>
                            <div class="input-group has-validation">
                                <span class="input-group-text">$</span>
                                <InputNumber id="precio" class="@ClaseCampo("Precio")" @bind-Value="producto.Precio" min="0" step="0.01" />
                                <div class="invalid-feedback">@Error("Precio")</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label" for="stock">Stock *</label>
                                <InputNumber id="stock" class="@ClaseCampo("Stock")" @bind-Value="producto.Stock" min="0" />
                                <div class="invalid-feedback">@Error("Stock")</div>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label" for="stockMin">Stock mínimo *</label>
                                <InputNumber id="stockMin" class="@ClaseCampo("StockMin")" @bind-Value="producto.StockMin" min="0" />
                                <div class="invalid-feedback">@Error("StockMin")</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(errorServidor))
                        {
                            <div class="alert alert-warning mb-0">@errorServidor</div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Cerrar" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback<string> OnGuardado { get; set; }

    [Parameter]
    public List<CategoriaDTO> Categorias { get; set; } = new();

    private bool visible;
    private bool guardando;
    private FormMode modo;
    private ProductoDTO producto = new();
    private string? errorServidor;
    private readonly Dictionary<string, string> errores = new();

    public void MostrarAlta()
    {
        modo = FormMode.Add;
        producto = new ProductoDTO();
        Abrir();
    }

    public void MostrarEdicion(ProductoDTO existente)
    {
        modo = FormMode.Update;
        producto = new ProductoDTO
        {
            Id = existente.Id,
            Nombre = existente.Nombre,
            Descripcion = existente.Descripcion,
            Unidad = existente.Unidad,
            Precio = existente.Precio,
            Categoria = existente.Categoria,
            Stock = existente.Stock,
            StockMin = existente.StockMin
        };
        Abrir();
    }

    private void Abrir()
    {
        errores.Clear();
        errorServidor = null;
        visible = true;
        StateHasChanged();
    }

    private void Cerrar()
    {
        visible = false;
    }

    private string ClaseCampo(string campo) =>
        errores.ContainsKey(campo) ? "form-control is-invalid" : "form-control";

    private string ClaseSelect(string campo) =>
        errores.ContainsKey(campo) ? "form-select is-invalid" : "form-select";

    private string? Error(string campo) =>
        errores.TryGetValue(campo, out var mensaje) ? mensaje : null;

    private bool Validar()
    {
        errores.Clear();

        if (string.IsNullOrWhiteSpace(producto.Nombre))
            errores["Nombre"] = "El nombre es requerido";
        else if (producto.Nombre.Trim().Length > 100)
            errores["Nombre"] = "El nombre no puede superar los 100 caracteres";

        if (producto.Categoria <= 0)
            errores["Categoria"] = "Seleccione la categoría del producto";

        if (producto.Precio <= 0)
            errores["Precio"] = "El precio debe ser mayor a 0";
        else if (producto.Precio > 10_000_000)
            errores["Precio"] = "El precio no puede superar $ 10.000.000";

        if (producto.Descripcion?.Length > 255)
            errores["Descripcion"] = "La descripción no puede superar los 255 caracteres";

        if (producto.Unidad?.Trim().Length > 20)
            errores["Unidad"] = "La unidad no puede superar los 20 caracteres";

        if (producto.Stock < 0)
            errores["Stock"] = "El stock no puede ser negativo";

        if (producto.StockMin < 0)
            errores["StockMin"] = "El stock mínimo no puede ser negativo";

        return errores.Count == 0;
    }

    private async Task GuardarAsync()
    {
        errorServidor = null;

        if (!Validar())
            return;

        producto.Nombre = producto.Nombre.Trim();
        producto.Descripcion = string.IsNullOrWhiteSpace(producto.Descripcion) ? null : producto.Descripcion.Trim();
        producto.Unidad = string.IsNullOrWhiteSpace(producto.Unidad) ? null : producto.Unidad.Trim();

        try
        {
            guardando = true;

            if (modo == FormMode.Update)
                await ProductoApiClient.UpdateAsync(producto);
            else
                await ProductoApiClient.AddAsync(producto);

            visible = false;

            await OnGuardado.InvokeAsync(modo == FormMode.Add
                ? $"Producto \"{producto.Nombre}\" creado correctamente."
                : $"Producto \"{producto.Nombre}\" actualizado correctamente.");
        }
        catch (UnauthorizedAccessException)
        {
            visible = false;
            Navigation.NavigateTo("login?expirada=true");
        }
        catch (Exception ex)
        {
            errorServidor = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}
