@inject NavigationManager Navigation

@if (visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="usuario" OnSubmit="GuardarAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">@(modo == FormMode.Add ? "Nuevo usuario" : $"Modificar usuario \"{usuarioOriginal}\"")</h5>
                        <button type="button" class="btn-close" @onclick="Cerrar" disabled="@guardando"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-5 mb-3">
                                <label class="form-label" for="username">Usuario *</label>
                                <InputText id="username" class="@ClaseCampo("Username")" @bind-Value="usuario.Username"
                                           maxlength="50" autocomplete="off" />
                                <div class="invalid-feedback">@Error("Username")</div>
                            </div>
                            <div class="col-7 mb-3">
                                <label class="form-label" for="nombreCompleto">Nombre completo *</label>
                                <InputText id="nombreCompleto" class="@ClaseCampo("NombreCompleto")"
                                           @bind-Value="usuario.NombreCompleto" maxlength="100" />
                                <div class="invalid-feedback">@Error("NombreCompleto")</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-5 mb-3">
                                <label class="form-label" for="rol">Rol *</label>
                                <InputSelect id="rol" class="@ClaseSelect("Rol")" @bind-Value="usuario.Rol">
                                    <option value="Administrador">Administrador</option>
                                    <option value="Empleado">Empleado</option>
                                </InputSelect>
                                <div class="invalid-feedback">@Error("Rol")</div>
                            </div>
                            <div class="col-7 mb-3">
                                <label class="form-label" for="sucursal">Sucursal</label>
                                <InputSelect id="sucursal" class="form-select" @bind-Value="sucursalId">
                                    <option value="0">(Sin sucursal asignada)</option>
                                    @foreach (var sucursal in Sucursales.Where(s => s.Activa || s.Id == usuario.SucursalId))
                                    {
                                        <option value="@sucursal.Id">@sucursal.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox id="activo" class="@($"form-check-input {(errores.ContainsKey("Activo") ? "is-invalid" : null)}")"
                                           @bind-Value="usuario.Activo" />
                            <label class="form-check-label" for="activo">Usuario activo (puede iniciar sesión)</label>
                            <div class="invalid-feedback">@Error("Activo")</div>
                        </div>

                        <fieldset class="border rounded p-3 mb-2">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">
                                @(modo == FormMode.Add ? "Contraseña *" : "Cambiar contraseña (opcional)")
                            </legend>
                            <div class="row">
                                <div class="col-6">
                                    <label class="form-label" for="password">Contraseña</label>
                                    <InputText id="password" type="password" class="@ClaseCampo("Password")"
                                               @bind-Value="password" autocomplete="new-password" maxlength="100" />
                                    <div class="invalid-feedback">@Error("Password")</div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="confirmar">Confirmar</label>
                                    <InputText id="confirmar" type="password" class="@ClaseCampo("Confirmar")"
                                               @bind-Value="confirmar" autocomplete="new-password" maxlength="100" />
                                    <div class="invalid-feedback">@Error("Confirmar")</div>
                                </div>
                            </div>
                            <div class="form-text">
                                @(modo == FormMode.Add ? "Mínimo 6 caracteres." : "Dejar en blanco para mantener la contraseña actual.")
                            </div>
                        </fieldset>

                        @if (!string.IsNullOrEmpty(errorServidor))
                        {
                            <div class="alert alert-warning mb-0 mt-3">@errorServidor</div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Cerrar" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback<string> OnGuardado { get; set; }

    [Parameter]
    public List<SucursalDTO> Sucursales { get; set; } = new();

    [Parameter]
    public int UsuarioActualId { get; set; }

    private bool visible;
    private bool guardando;
    private FormMode modo;
    private UsuarioDTO usuario = new();
    private string usuarioOriginal = string.Empty;
    private bool eraAdministrador;
    private int sucursalId;
    private string? password;
    private string? confirmar;
    private string? errorServidor;
    private readonly Dictionary<string, string> errores = new();

    private bool EsUnoMismo => modo == FormMode.Update && usuario.Id == UsuarioActualId;

    public void MostrarAlta()
    {
        modo = FormMode.Add;
        usuario = new UsuarioDTO { Rol = "Empleado", Activo = true };
        Abrir();
    }

    public void MostrarEdicion(UsuarioDTO existente)
    {
        modo = FormMode.Update;
        usuario = new UsuarioDTO
        {
            Id = existente.Id,
            Username = existente.Username,
            NombreCompleto = existente.NombreCompleto,
            Rol = existente.EsAdministrador ? "Administrador" : existente.Rol,
            EsAdministrador = existente.EsAdministrador,
            Activo = existente.Activo,
            SucursalId = existente.SucursalId
        };
        Abrir();
    }

    private void Abrir()
    {
        usuarioOriginal = usuario.Username;
        eraAdministrador = usuario.EsAdministrador;
        sucursalId = usuario.SucursalId ?? 0;
        password = null;
        confirmar = null;
        errores.Clear();
        errorServidor = null;
        visible = true;
        StateHasChanged();
    }

    private void Cerrar()
    {
        visible = false;
    }

    private string ClaseCampo(string campo) =>
        errores.ContainsKey(campo) ? "form-control is-invalid" : "form-control";

    private string ClaseSelect(string campo) =>
        errores.ContainsKey(campo) ? "form-select is-invalid" : "form-select";

    private string? Error(string campo) =>
        errores.TryGetValue(campo, out var mensaje) ? mensaje : null;

    private bool Validar()
    {
        errores.Clear();

        var username = usuario.Username?.Trim() ?? string.Empty;
        if (username.Length == 0)
            errores["Username"] = "El nombre de usuario es requerido";
        else if (username.Length < 3)
            errores["Username"] = "Debe tener al menos 3 caracteres";
        else if (username.Any(char.IsWhiteSpace))
            errores["Username"] = "No puede contener espacios";

        if (string.IsNullOrWhiteSpace(usuario.NombreCompleto))
            errores["NombreCompleto"] = "El nombre completo es requerido";

        if (usuario.Rol != "Administrador" && usuario.Rol != "Empleado")
            errores["Rol"] = "Seleccione el rol del usuario";
        else if (EsUnoMismo && eraAdministrador && usuario.Rol != "Administrador")
            errores["Rol"] = "No puede quitarse a sí mismo el rol de administrador";

        if (EsUnoMismo && !usuario.Activo)
            errores["Activo"] = "No puede desactivar su propio usuario";

        var clave = password ?? string.Empty;
        if (modo == FormMode.Add && clave.Length == 0)
            errores["Password"] = "La contraseña es requerida para un usuario nuevo";
        else if (clave.Length > 0 && clave.Length < 6)
            errores["Password"] = "Debe tener al menos 6 caracteres";
        else if (clave != (confirmar ?? string.Empty))
            errores["Confirmar"] = "Las contraseñas no coinciden";

        return errores.Count == 0;
    }

    private async Task GuardarAsync()
    {
        errorServidor = null;

        if (!Validar())
            return;

        usuario.Username = usuario.Username.Trim();
        usuario.NombreCompleto = usuario.NombreCompleto.Trim();
        usuario.SucursalId = sucursalId == 0 ? null : sucursalId;
        usuario.Password = string.IsNullOrEmpty(password) ? null : password;

        try
        {
            guardando = true;

            if (modo == FormMode.Update)
                await UsuarioApiClient.UpdateAsync(usuario);
            else
                await UsuarioApiClient.AddAsync(usuario);

            visible = false;

            await OnGuardado.InvokeAsync(modo == FormMode.Add
                ? $"Usuario \"{usuario.Username}\" creado correctamente."
                : $"Usuario \"{usuario.Username}\" actualizado correctamente.");
        }
        catch (UnauthorizedAccessException)
        {
            visible = false;
            Navigation.NavigateTo("login?expirada=true");
        }
        catch (Exception ex)
        {
            errorServidor = ex.Message;
        }
        finally
        {
            usuario.Password = null;
            guardando = false;
        }
    }
}
